# ---------------------------------------------------------------------------
# All keys are OPTIONAL. With none of them set the app runs end-to-end on
# free fallbacks (Web Speech API, rule-based marking, pre-written chapters).
# See README "What improves when you add keys".
# ---------------------------------------------------------------------------

# Claude API - story generation, item generation, open-answer marking,
# 作文 feedback, and OCR for the 课文 companion.
ANTHROPIC_API_KEY=

# Azure Speech - neural TTS voices and pronunciation assessment (zh-CN).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Local database file (libSQL/SQLite).
DATABASE_URL=file:./data/app.db

# Session signing secret. Any random string; generated on first setup if blank.
SESSION_SECRET=
